# Copier ce fichier en .env.prod sur le VPS, puis remplacer TOUTES les
# valeurs par des vraies (jamais commiter .env.prod — déjà dans .gitignore).

# --- Django ---
# Générer une vraie valeur avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-real-random-value
DJANGO_DEBUG=False
# Domaine(s) ou IP du VPS, séparés par des virgules, SANS schéma ni port.
# Ex: DJANGO_ALLOWED_HOSTS=203.0.113.5  ou  DJANGO_ALLOWED_HOSTS=bordereau.mondomaine.com
DJANGO_ALLOWED_HOSTS=change-me
# Même chose mais AVEC le schéma (http:// ou https://) — nécessaire pour
# que la connexion à /admin/ fonctionne (protection CSRF de Django).
# Ex: DJANGO_CSRF_TRUSTED_ORIGINS=http://203.0.113.5
DJANGO_CSRF_TRUSTED_ORIGINS=change-me

# --- Base de données ---
POSTGRES_DB=bordereau
POSTGRES_USER=bordereau
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Celery / Redis (interne au réseau docker-compose, pas besoin de changer) ---
CELERY_BROKER_URL=redis://redis:6379/0

# --- Stockage des fichiers (papiers entête, PDF générés) ---
# "local" = disque du VPS (dossier ./media, voir docker-compose.prod.yml).
# Passer à "s3" + remplir les AWS_* plus bas pour un stockage objet externe.
STORAGE_BACKEND=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
